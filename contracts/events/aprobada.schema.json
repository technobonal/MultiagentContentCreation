{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiagent.local/contracts/events/aprobada.schema.json",
  "$comment": "El humano aprobó el pack. Reanuda el grafo con Command(resume=...). El rechazo es el evento 'rechazada'.",
  "title": "aprobada",
  "required": ["agente", "payload"],
  "properties": {
    "agente": { "const": "humano" },
    "payload": {
      "$comment": "Decisión del humano con un comentario opcional.",
      "type": "object",
      "required": ["decision"],
      "additionalProperties": false,
      "properties": {
        "decision": {
          "const": "aprobada",
          "description": "Única decisión posible en 0.1."
        },
        "comentario": {
          "$ref": "../common.schema.json#/$defs/texto"
        },
        "excepcion": {
          "$comment": "La persona aprobó sin visto bueno (semáforo en rojo). El motivo es obligatorio y el run no queda como 'aprobada'.",
          "type": "object",
          "required": ["motivo", "slides_en_rojo"],
          "additionalProperties": false,
          "properties": {
            "motivo": { "$ref": "../common.schema.json#/$defs/texto" },
            "slides_en_rojo": {
              "$comment": "Slides en rojo al decidir. Vacío si el problema era de todo el carrusel (por ejemplo, sin fuente).",
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "../common.schema.json#/$defs/slide_num" }
            }
          }
        }
      }
    }
  }
}
