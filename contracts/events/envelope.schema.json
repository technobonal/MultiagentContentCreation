{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multiagent.local/contracts/events/envelope.schema.json",
  "$comment": "Sobre común de todo evento (B.2). Define los campos que todos comparten; el payload y las reglas propias de cada tipo viven en un esquema por evento, que event.schema.json despacha según 'tipo'.",
  "title": "Sobre del evento",
  "type": "object",
  "required": ["version", "run_id", "seq", "timestamp", "origen", "agente", "tipo", "payload"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+$",
      "description": "Versión del contrato. 0.x hasta cerrar la Fase 2; los cambios compatibles suman campos opcionales."
    },
    "run_id": {
      "$ref": "../common.schema.json#/$defs/run_id"
    },
    "seq": {
      "$ref": "../common.schema.json#/$defs/seq"
    },
    "timestamp": {
      "$ref": "../common.schema.json#/$defs/timestamp"
    },
    "origen": {
      "$ref": "../common.schema.json#/$defs/origen"
    },
    "agente": {
      "$ref": "../common.schema.json#/$defs/agente"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "run_iniciada", "fuente_indexada", "brief_emitido", "plantilla_elegida",
        "texto_propuesto", "colocar_fondo", "escribir_texto", "verificacion_fidelidad",
        "hallazgo_abierto", "hallazgo_corregido", "corregir", "aprobacion_solicitada",
        "aprobada", "editada", "run_finalizada"
      ],
      "description": "Nombre del evento (catálogo 0.1). Identificadores en ASCII: 'ajustar_tamano', no 'ajustar_tamaño'."
    },
    "slide": {
      "$ref": "../common.schema.json#/$defs/slide_num"
    },
    "causa": {
      "$ref": "../common.schema.json#/$defs/seq"
    },
    "payload": {
      "type": "object",
      "description": "Datos propios de cada tipo; su forma exacta la fija el esquema del evento."
    }
  }
}
